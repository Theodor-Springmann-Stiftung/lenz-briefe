---
import Layout from '../../layouts/Layout.astro';
import LicenseTable from '../../components/LicenseTable.astro';
import { loadLicenses, readLicenseFile, licenseFileUrl } from '../../lib/licenses.mjs';
import { pageUrl } from '../../lib/pages';
import { revision } from '../../lib/revision';
const entries = loadLicenses();
const runtime = entries.filter((entry) => entry.runtime);
const build = entries.filter((entry) => !entry.runtime);
const notices = runtime.flatMap((entry) => {
  const copyright = entry.files.find(({ file }) => file.endsWith('/COPYRIGHT-from-font.txt'));
  const mit =
    entry.license === 'MIT'
      ? entry.files.find(({ label }) => /^LICENSE(?:\.md|\.txt)?$/i.test(label))
      : undefined;
  const remix =
    entry.product === 'remixicon'
      ? entry.files.find(({ label }) => label === 'License')
      : undefined;
  const file = copyright ?? mit ?? remix;
  return file
    ? [{ name: remix ? 'Remix Icon' : entry.name, text: readLicenseFile(file.file) }]
    : [];
});
const url = (file: string) => licenseFileUrl(file, import.meta.env.BASE_URL);
---

<Layout
  title="Lizenzen und Drittanbieter"
  description="Lizenzbedingungen der digitalen Edition, ihrer XML-Daten, Schriftarten, Icons und Software-Abhängigkeiten."
>
  <article class="about-page">
    <div class="about-page-content page-prose">
      <h1>Lizenzen und Drittanbieter</h1>
      <nav aria-label="Inhalt dieser Seite">
        <ul>
          <li>
            <a href="#edition">Website und XML-Daten</a>
          </li>
          <li>
            <a href="#hinweise">Lizenz- und Urheberrechtshinweise</a>
          </li>
          <li>
            <a href="#laufzeit">Laufzeitabhängigkeiten</a>
          </li>
          <li>
            <a href="#build">Build-Abhängigkeiten</a>
          </li>
        </ul>
      </nav>

      <h2 id="edition">Website und XML-Daten</h2>
      <p>
        Die redaktionellen Inhalte dieser Website und die XML-Daten der digitalen Edition stehen,
        soweit nicht anders gekennzeichnet, unter der Lizenz{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/deed.de" rel="license">
          Creative Commons Namensnennung 4.0 International (CC BY 4.0)
        </a>
        .
      </p>
      <p>
        Bei jeder Vervielfältigung, Weitergabe oder Bearbeitung der Inhalte sind angemessene
        Urheber- und Quellenangaben, ein Link zur Lizenz und ein Hinweis auf vorgenommene Änderungen
        erforderlich. Beachten Sie unsere <a href={pageUrl('zitierempfehlung')}>Zitierempfehlung</a>{' '}
        und den{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/legalcode.de">
          vollständigen Lizenztext
        </a>
        .
      </p>
      <p>
        Die CC-BY-Angabe gilt nicht pauschal für Drittanbieter-Software, Schriftarten, Icons oder
        gesondert gekennzeichnete Abbildungen. Für diese gelten die jeweiligen Rechte- und
        Lizenzangaben. Gemeinfreie Bestandteile bleiben gemeinfrei.
      </p>
      <p>
        Der eigene Anwendungscode steht, soweit nicht anders gekennzeichnet, unter der{' '}
        <a href={url('project/LICENSE-MIT.txt')}>MIT-Lizenz</a>, Copyright © 2026 Theodor Springmann
        Stiftung. Die Lizenz erlaubt die Nutzung, Änderung und Weitergabe des Codes unter
        Beibehaltung des Copyright- und Lizenzhinweises.
      </p>
      <p>
        Die ergänzenden Personen- und Ortsinformationen stammen aus der Gemeinsamen Normdatei
        (GND) der Deutschen Nationalbibliothek und werden über{' '}
        <a href="https://lobid.org/gnd">lobid-gnd</a> des Hochschulbibliothekszentrums
        Nordrhein-Westfalen bezogen. Diese Normdaten stehen unter{' '}
        <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.de" rel="license">CC0 1.0</a>.
        Die jeweiligen GND-Einträge sind bei den Filterinformationen verlinkt.
        Die lokal gespeicherten Website-Icons kennzeichnen die verlinkten Angebote und unterliegen
        den jeweiligen Rechten ihrer Anbieter; sie fallen nicht unter die CC0-Freigabe der Normdaten.
        Ihre Herkunft ist im <a href={url('reference-icon-sources.json')}>Quellenverzeichnis der Icons</a> dokumentiert.
      </p>

      <h2 id="hinweise" class="pb-4">Lizenz- und Urheberrechtshinweise Dritter</h2>

      <h3 id="laufzeit" class="pb-2">Laufzeitabhängigkeiten</h3>
      <p>
        Diese Bibliotheken, Schriftarten und Icons sind Teil der ausgelieferten Website.
        Tailwind erzeugt beispielsweise die mitgelieferten CSS-Regeln beim Build. Vivliostyle
        layoutet die Druckseiten im Client. Popper & Tippy.js dienen zur Positionierung von
        Tooltips.
      </p>
      <LicenseTable entries={runtime} caption="Laufzeitabhängigkeiten der Website" />

      <h3 id="build" class="py-2">Build-Abhängigkeiten</h3>
      <p>
        Diese Werkzeuge und ihre direkten oder indirekten Abhängigkeiten dienen der Erstellung und
        Prüfung der statischen Website. Dazu gehören auch die Python-Werkzeuge für die
        XML-Verarbeitung und optionale Pakete für andere Betriebssysteme.
      </p>
      <details class="license-notice">
        <summary>
          Alle {build.length} Build-Abhängigkeiten und weiteren mitgeführten Produkte
        </summary>
        <LicenseTable
          entries={build}
          caption="Build-Abhängigkeiten und weitere mitgeführte Produkte"
        />
      </details>
      <p>
        Bei einzelnen Paketen liegt nur eine Lizenzangabe des Herausgebers vor; diese Fälle sind in
        den verlinkten Hinweisen kenntlich gemacht. Maßgeblich sind die beigefügten Lizenztexte,
        nicht allein die Kurzbezeichnungen.
      </p>
      <p>
        <a href={pageUrl('datenschutz')}>&larr; Zurück zu Impressum &amp; Datenschutz</a>
      </p>
    </div>
  </article>
</Layout>
<style>
  .license-notice {
    margin-block: 0.75em;
    border: 1px solid var(--color-rule);
    padding: 0.7em 1em;
  }
  .license-notice summary {
    font-weight: 600;
  }
  .license-notice pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.85rem;
    line-height: 1.55;
  }
</style>
