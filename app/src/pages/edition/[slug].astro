---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EditionGuidelines from '../../components/EditionGuidelines.astro';
import { editionPages } from '../../lib/pages';

export async function getStaticPaths() {
  return (await editionPages()).map(page => ({ params: { slug: page.id }, props: { page } }));
}

interface Props { page: CollectionEntry<'pages'> }
const { page } = Astro.props;
const { Content } = await render(page);
---
<Layout title={`${page.data.title} · Lenz Briefe`} description={page.data.description}>
  <article class="about-page">
    <div class="page-prose"><Content /></div>
    {page.data.legend && <EditionGuidelines />}
  </article>
</Layout>
