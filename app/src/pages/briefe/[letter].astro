---
import Layout from '../../layouts/Layout.astro';
import LetterHeader from '../../components/LetterHeader.astro';
import Icon from '../../components/Icon.astro';
import SidenotePosition from '../../components/SidenotePosition.astro';
import {sidenoteOrder} from '../../lib/margin-placement.mjs';
import {handFonts} from '../../lib/hand-fonts.mjs';
import {catalog, letterFiles, letterUrl, titleFor, type Letter} from '../../lib/edition';
export function getStaticPaths() {
  return catalog.letters.map((letter,index) => ({params:{letter:letter.letter}, props:{letter,index}}));
}
interface Props { letter: Letter; index: number }
const {letter,index} = Astro.props;
const {text,sidenotes,traditions} = letterFiles(letter.letter);
const traditionLinks = traditions.filter(item => item.type === 'app' && item.id && item.name);
const orderedSidenotes = [...sidenotes].sort((a, b) => Number(a.page) - Number(b.page) || sidenoteOrder(a.pos) - sidenoteOrder(b.pos) || a.sourceOrder - b.sourceOrder);
const placed = orderedSidenotes.filter(note => note.anchorId);
const unplaced = orderedSidenotes.filter(note => !note.anchorId);
const previous = catalog.letters[index - 1];
const next = catalog.letters[index + 1];
const hands = Object.fromEntries(letter.handRefs.map(ref => [ref, catalog.people[ref]?.name || `Unbekannte Hand (${ref})`]));
const senderRefs = new Set(letter.events.filter(event => event.type === 'sent').flatMap(event => event.persons.map(person => person.ref)));
const handStyles = [...handFonts(letter.handRefs, senderRefs)].map(([ref, font]) => `${[
  `.letter-content .edition-text .hand[data-ref=${JSON.stringify(ref)}]`,
  `.letter-content .hand-sample[data-ref=${JSON.stringify(ref)}]`,
].join(', ')} { font-family: ${font};${font === 'var(--font-hand-second)' ? ' font-weight: 600; font-variant-numeric: lining-nums;' : ''} }`).join('\n');
const sectionLinks = [...traditionLinks, ...(letter.handRefs.length ? [{id: 'haende', name: 'Hände'}] : [])];
---
<Layout wide title={`Brief ${letter.letter} · ${titleFor(letter)} · Lenz Briefe`}>
  {handStyles && <style is:inline set:html={handStyles} />}
  <div class="letter-content">
    <div class="detail-header">
      <LetterHeader letter={letter} />
      <div class="letter-toolbar">
        <nav class="letter-navigation" aria-label="Briefnavigation">
          {previous && <a href={letterUrl(previous.letter)} aria-label={`Vorheriger Brief: ${previous.letter}`}><Icon name="arrowLeft" /></a>}
          <span class="navigation-position">LKB {letter.letter}</span>
          {next && <a href={letterUrl(next.letter)} aria-label={`Nächster Brief: ${next.letter}`}><Icon name="arrowRight" /></a>}
        </nav>
      </div>
      {sectionLinks.length > 0 && <nav class="reading-toolbar" aria-label="Abschnitte zum Brief"><a href="#ueberlieferung">{sectionLinks.map(item => item.name).join(', ')} <Icon name="arrowDown" class="section-link-arrow" /></a></nav>}
    </div>
    <div class="reading-layout" data-reading-layout>
      <article class="edition-text letter-body" aria-label={`Text von Brief ${letter.letter}`} set:html={text} />
      <aside class="page-margin" aria-label="Seitenzahlen">
        {letter.pages.map((page,i) => !(i === 0 && page === '1') && <div class="marginal-item page-number" data-anchor={`page-${page}`} data-priority="0"><a href={`#page-${page}`} aria-label={`Seite ${page}`}>{page}</a></div>)}
      </aside>
      <aside class="marginalia" aria-label="Randnotizen und Hände">
        {placed.map(note => <div class="marginal-item margin-note sidenote-layout" data-anchor={note.anchorId!} data-priority="2"><SidenotePosition position={note.pos} /><div class="edition-text" set:html={note.html} /><div class="sidenote-details"><p class="note-annotation sidenote-description">{note.annotation}</p></div></div>)}
      </aside>
    </div>
    {unplaced.length > 0 && <section class="unplaced-notes" aria-labelledby="unplaced-title"><p class="eyebrow" id="unplaced-title">Weitere Randnotizen</p>{unplaced.map(note => <div class="unplaced-note sidenote-layout"><SidenotePosition position={note.pos} /><div class="edition-text" set:html={note.html} /><div class="sidenote-details"><p class="note-annotation sidenote-description">{note.annotation}</p><p class="note-annotation">Seite {note.page} · Im Text ist keine zugehörige Seitenmarke verzeichnet.</p></div></div>)}</section>}
    <section class="apparatus" id="ueberlieferung" aria-label="Überlieferung & Textkritik">
      {traditions.length ? traditions.map(item => <Fragment>
        <div class="apparatus-entry" id={item.id}>
          {item.type === 'app' && <h2>{item.name}</h2>}
          <div class="edition-text apparatus-text" set:html={item.html} />
        </div>
      </Fragment>) : <p>Keine Angaben zur Überlieferung vorhanden.</p>}
      {letter.handRefs.length > 0 && <div class="apparatus-entry hand-key" id="haende"><h2>Hände</h2><ul class="edition-text apparatus-text">{Object.entries(hands).map(([ref, name]) => <li><span class="hand-sample" data-ref={ref} aria-hidden="true">Aa</span><button type="button" data-hand-ref={ref}>{name}</button></li>)}</ul></div>}
    </section>
  </div>
  <script type="application/json" id="hand-data" set:html={JSON.stringify(hands).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/search-highlight';</script>
  <script>import '../../scripts/margins';</script>
  <script>import '../../scripts/note-connections';</script>
</Layout>
