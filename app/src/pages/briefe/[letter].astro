---
import Layout from '../../layouts/Layout.astro';
import LetterCitation from '../../components/LetterCitation.astro';
import LetterHeader from '../../components/LetterHeader.astro';
import CorrespondenceNavigation from '../../components/CorrespondenceNavigation.astro';
import Icon from '../../components/Icon.astro';
import QuickLegend from '../../components/QuickLegend.astro';
import Sidenote from '../../components/Sidenote.astro';
import { sidenoteOrder } from '../../lib/margin-placement.mjs';
import { handDeclarations } from '../../lib/hand-settings.mjs';
import { handFonts, handKeyRefs } from '../../lib/hand-fonts.mjs';
import { prepareHandControls } from '../../lib/hand-labels.mjs';
import { catalog, letterFiles, letterUrl, titleFor, type Letter } from '../../lib/edition';
import { letterDateLabel } from '../../lib/page-titles.mjs';
export function getStaticPaths() {
  return catalog.letters.map((letter, index) => ({
    params: { letter: letter.letter },
    props: { letter, index },
  }));
}
interface Props {
  letter: Letter;
  index: number;
}
const { letter, index } = Astro.props;
const { text, sidenotes, traditions } = letterFiles(letter.letter);
const inPositionNotes = new Map(
  sidenotes.filter((note) => note.type === 'inpos').map((note) => [note.id, note]),
);
const traditionLinks = traditions.filter((item) => item.type === 'app' && item.id && item.name);
const textLoss = traditions.find((item) => item.type === 'app' && item.name === 'Textverlust');
const orderedSidenotes = sidenotes
  .filter((note) => note.type !== 'inpos')
  .sort(
    (a, b) =>
      Number(a.page) - Number(b.page) ||
      sidenoteOrder(a.pos) - sidenoteOrder(b.pos) ||
      a.sourceOrder - b.sourceOrder,
  );
const placed = orderedSidenotes.filter((note) => note.anchorId);
const unplaced = orderedSidenotes.filter((note) => !note.anchorId);
const previous = catalog.letters[index - 1];
const next = catalog.letters[index + 1];
const senderRefs = new Set(
  letter.events
    .filter((event) => event.type === 'sent')
    .flatMap((event) => event.persons.map((person) => person.ref)),
);
const handRefs = handKeyRefs(letter.handRefs, senderRefs, letter.handOrder);
const hands = Object.fromEntries(
  handRefs.map((ref) => [ref, catalog.people[ref]?.name || `Unbekannte Hand (${ref})`]),
);
const preparedText = prepareHandControls(text, hands, {
  anchors: true,
  labelStarts: true,
  baseRef: handRefs.length > 1 ? senderRefs.values().next().value : undefined,
});
const textParts = preparedText.html.split(
  /<div class="sidenote-slot" data-sidenote-id="([^"]+)"><\/div>/,
);
const renderedNotes = new Set(textParts.filter((_, index) => index % 2 === 1));
for (const id of inPositionNotes.keys()) {
  if (!renderedNotes.has(id)) throw new Error(`Missing in-position sidenote slot: ${id}`);
}
const handStyles = [
  // Also apply the base settings to the untagged main hand.
  `.letter-content .edition-text { ${handDeclarations('base')} }`,
  ...[...handFonts(handRefs, senderRefs)].map(([ref, font]) => {
    const textSelector = `.letter-content .edition-text .hand[data-ref=${JSON.stringify(ref)}]`;
    const sampleSelector = `.letter-content .hand-sample[data-ref=${JSON.stringify(ref)}]`;
    const settings =
      font === 'var(--font-hand-second)'
        ? 'third'
        : font === 'var(--font-hand)'
          ? 'second'
          : 'base';
    return `${textSelector}, ${sampleSelector} { font-family:${font}; ${handDeclarations(settings)} font-variant-numeric:lining-nums; }`;
  }),
].join('\n');
const sectionLinks = [
  ...traditionLinks,
  ...(letter.handRefs.length ? [{ id: 'haende', name: 'Hände' }] : []),
  { id: 'zitieren', name: 'Zitation' },
];
---

<Layout wide title={`${titleFor(letter)}, ${letterDateLabel(letter.events)}`}>
  <div slot="letter-menu" class="letter-toolbar">
    <div class="letter-context-tools">
      <CorrespondenceNavigation letter={letter} />
      <button
        class="letter-print-button"
        type="button"
        data-print-letter
        aria-label="Druck&hairsp;/&hairsp;PDF"
        data-tooltip="Druck&hairsp;/&hairsp;PDF"
        data-tippy-placement="top"
        data-tippy-trigger="mouseenter focus"
      >
        <Icon name="printer" />
      </button>
      <span class="letter-print-status" role="status" data-print-status hidden>
        <span data-print-message></span>
        <progress class="letter-print-progress" data-print-progress max="100" value="0" aria-label="Druckvorbereitung" hidden></progress>
      </span>
    </div>
    <nav class="letter-navigation" aria-label="Briefnavigation">
      {previous && (
        <a
          href={letterUrl(previous.letter)}
          rel="prev"
          aria-label={`Vorheriger Brief: ${previous.letter}`}
        >
          <Icon name="arrowLeft" />
        </a>
      )}
      <span class="navigation-position" id="letter-number" data-search-target>
        LKB
      </span>
      {next && (
        <a
          href={letterUrl(next.letter)}
          rel="next"
          aria-label={`Nächster Brief: ${next.letter}`}
        >
          <Icon name="arrowRight" />
        </a>
      )}
    </nav>
  </div>
  {handStyles && <style is:inline set:html={handStyles} />}
  <div class="letter-content">
    <div class="letter-spine" aria-hidden="true"></div>
    <div class="detail-header-group">
      <div class="detail-header">
        <LetterHeader letter={letter} />
      </div>
    </div>
    <div class="letter-reading-panel">
      {sectionLinks.length > 0 && (
        <nav class="reading-toolbar" aria-label="Abschnitte zum Brief">
          <a href="#ueberlieferung">
            {sectionLinks.map((item) => item.name).join(', ')}{' '}
            <Icon name="arrowDown" class="section-link-arrow" />
          </a>
        </nav>
      )}
      <div
        class="reading-layout"
        data-reading-layout
        data-base-hand={senderRefs.values().next().value}
      >
        <article class="edition-text letter-body" aria-label={`Text von Brief ${letter.letter}`}>
          {textParts.map((part, index) => {
            if (index % 2 === 0) return <Fragment set:html={part} />;
            const note = inPositionNotes.get(part);
            if (!note) throw new Error(`Unknown in-position sidenote: ${part}`);
            return (
              <div class="inpos-note sidenote-layout">
                <Sidenote note={note} hands={hands} />
              </div>
            );
          })}
        </article>
        <aside class="page-margin" aria-label="Seitenzahlen">
          {letter.pages.map(
            (page, i) =>
              !(i === 0 && page === '1') && (
                <div class="marginal-item page-number" data-anchor={`page-${page}`} data-priority="0">
                  <a href={`#page-${page}`} aria-label={`Seite ${page}`}>
                    {page}
                  </a>
                </div>
              ),
          )}
        </aside>
        <aside class="marginalia" aria-label="Randnotizen und Hände">
          {placed.map((note) => (
            <div
              class="marginal-item margin-note sidenote-layout"
              data-anchor={note.anchorId!}
              data-priority="2"
            >
              <Sidenote note={note} hands={hands} />
            </div>
          ))}
          {preparedText.labels.map(({ ref, name, anchor }) => (
            <div class="marginal-item hand-label" data-anchor={anchor} data-priority="1">
              <button type="button" data-hand-ref={ref}>
                {name}
              </button>
            </div>
          ))}
        </aside>
        {textLoss && (
          <div class="text-loss-margin" id="text-loss-reason" data-text-loss-reason hidden>
            <div set:html={textLoss.html.replace(/\s+id="[^"]*"/g, '')} />
          </div>
        )}
      </div>
      {unplaced.length > 0 && (
        <section class="unplaced-notes" aria-label="Weitere Randnotizen">
          {unplaced.map((note) => (
            <div class="unplaced-note sidenote-layout">
              <Sidenote note={note} hands={hands}>
                <p class="note-annotation">
                  Im Text ist keine zugehörige Seitenmarke verzeichnet.
                </p>
              </Sidenote>
            </div>
          ))}
        </section>
      )}
    </div>
    <section class="apparatus" id="ueberlieferung" aria-label="Überlieferung & Textkritik">
      {traditions.length ? (
        traditions.map((item) => (
          <Fragment>
            <div class="apparatus-entry" id={item.id} data-text-loss-footer={item === textLoss || undefined}>
              {item.type === 'app' && <h2>{item.name}</h2>}
              <div class="edition-text apparatus-text apparatus-xml-text" set:html={item.html} />
            </div>
          </Fragment>
        ))
      ) : (
        <p>Keine Angaben zur Überlieferung vorhanden.</p>
      )}
      {handRefs.length > 0 && (
        <div class="apparatus-entry hand-key" id="haende">
          <h2>Hände</h2>
          <ul class="edition-text apparatus-text">
            {handRefs.map((ref) => (
              <li>
                <span class="hand-sample" data-ref={ref} aria-hidden="true">
                  Aa
                </span>
                <button type="button" data-hand-ref={ref}>
                  {hands[ref]}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
      <LetterCitation letter={letter} />
    </section>
  </div>
  <QuickLegend />
  <script>
    import '../../scripts/search-highlight';
  </script>
  <script>
    import '../../scripts/margins';
  </script>
  <script>
    import '../../scripts/letter-spine';
  </script>
  <script>
    import '../../scripts/note-connections';
  </script>
  <script>
    import '../../scripts/text-loss';
  </script>
  <script>
    import '../../scripts/print-letter';
  </script>
</Layout>
