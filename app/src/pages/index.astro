---
import Layout from '../layouts/Layout.astro';
import LetterHeader from '../components/LetterHeader.astro';
import Filter from '../components/Filter.astro';
import Icon from '../components/Icon.astro';
import {catalog, filterOptions, base} from '../lib/edition';
const records = catalog.letters.map(l => ({id: l.letter, group: l.groupId, people:l.personIds, places:l.placeIds}));
const firstGroup = catalog.groups[0];
---
<Layout>
  <section class="index-intro">
    <h1>Inhalt</h1>
    <div class="edition-count"><span>{catalog.letters.length} Briefe</span></div>
  </section>
  <section aria-label="Briefverzeichnis" class="catalog-section">
    <div class="active-filters" hidden>
      <div class="active-filter-pills" role="group" aria-label="Aktive Filter"></div>
      <button type="button" class="reset-filters"><Icon name="reset" />Alle zurücksetzen</button>
    </div>
    {(['person', 'place'] as const).map(kind => <template id={`filter-pill-${kind}`}><button type="button" class="filter-pill" data-filter-kind={kind}><Icon name="filter" class="filter-pill-icon" /><Icon name="filterOff" class="filter-pill-remove" /><span class="filter-pill-name"></span></button></template>)}
    <div class="filter-toolbar" role="group" aria-label="Filter und Sortierung">
      <div class="filter-controls"><Filter kind="person" label="Personen" options={filterOptions('person')} /><Filter kind="place" label="Orte" options={filterOptions('place')} /></div>
      <label class="catalog-search"><span class="sr-only">Briefe durchsuchen</span><Icon name="search" /><input type="search" placeholder="Briefe durchsuchen …" aria-describedby="search-placeholder-note" autocomplete="off" /></label>
      <span id="search-placeholder-note" class="sr-only">Designvorschau: Die Suche ist noch nicht aktiv.</span>
      <div class="sort-control"><label class="sr-only" for="sort-order">Sortierung</label><Icon name="sort" /><select id="sort-order"><option value="asc">Chronologisch aufsteigend</option><option value="desc">Chronologisch absteigend</option></select></div>
    </div>
    <nav class="year-navigation" aria-label="Zeiträume">
      {catalog.groups.map(group => <a href={`?group=${group.id}`} data-group={group.id} aria-current={group.id === firstGroup.id ? 'page' : undefined}>{group.label}<span>{group.count}</span></a>)}
      <a href={`${base}?group=all`} data-group="all">Alle Jahre <span>{catalog.letters.length}</span></a>
    </nav>
    <noscript><style is:inline>.letter-list > [hidden] { display: block !important; }</style><p class="notice">Alle Briefe sind unten chronologisch aufgeführt. Zum Filtern bitte JavaScript aktivieren.</p></noscript>
    <span id="result-count" class="sr-only" role="status" aria-live="polite">{firstGroup.count} Briefe</span>
    <ol class="letter-list">{catalog.letters.map(letter => <li data-letter={letter.letter} hidden={letter.groupId !== firstGroup.id}><LetterHeader letter={letter} compact /></li>)}</ol>
    <div class="empty-state" hidden><h2>Keine Briefe gefunden.</h2><p>Wählen Sie einen anderen Zeitraum oder weniger Filter.</p><button type="button" data-reset>Alle Briefe anzeigen</button></div>
  </section>
  <script type="application/json" id="filter-data" set:html={JSON.stringify({records, groups:catalog.groups.map(g=>g.id)}).replace(/</g, '\\u003c')} />
  <script>import '../scripts/catalog';</script>
</Layout>
