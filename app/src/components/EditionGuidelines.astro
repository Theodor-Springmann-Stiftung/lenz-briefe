---
import LegendExample from './LegendExample.astro';
import { legendSections } from '../lib/legend';
---
<lkb-legende class="edition-guidelines">
  {legendSections.map(({ title, entries }) => <section class="guideline-section" aria-label={title}>
    <h2>{title}</h2>
    <table class="guideline-table">
      <thead class="sr-only"><tr><th scope="col">Auszeichnung</th><th scope="col">Beispiel</th></tr></thead>
      <tbody>{entries.map(item => <tr data-tag={item.tag}>
        <th scope="row"><span>{item.label}</span>{item.short && <p>{item.short}</p>}</th>
        <td><div class="edition-text legend-example"><LegendExample item={item} /></div></td>
      </tr>)}</tbody>
    </table>
  </section>)}
</lkb-legende>
