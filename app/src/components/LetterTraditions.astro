---
type Props = {
  html: string | undefined;
};

const { html } = Astro.props;
---

{html && (
  <footer class="letter-traditions letter-body-prose" aria-label="Apparat zum Brief">
    <div set:html={html} />
  </footer>
)}

<style>
  .letter-traditions {
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--app-border);
    overflow-wrap: anywhere;
  }

  .letter-traditions :global(.tradition-category + .tradition-category) {
    margin-block-start: 2rem;
  }

  .letter-traditions :global(.tradition-category-heading) {
    margin-block-end: 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .letter-traditions :global(.tradition-app-heading) {
    margin-block-end: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .letter-traditions :global(.tradition-app + .tradition-app) {
    margin-block-start: 1.25rem;
  }
</style>
