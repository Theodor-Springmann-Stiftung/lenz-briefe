---
import { prepareHandControls } from '../lib/hand-labels.mjs';
import SidenotePosition from './SidenotePosition.astro';
import { sidenoteRotations } from '../lib/sidenote-position.mjs';
import type { Sidenote } from '../lib/edition';
interface Props {
  note: Sidenote;
  hands: Record<string, string>;
}
const { note, hands } = Astro.props;
const { labels } = prepareHandControls(note.html, hands);
const rotations = sidenoteRotations(note.html);
---

<SidenotePosition position={note.pos} rotations={rotations} />
<div class="edition-text" set:html={note.html} />
<div class="sidenote-details">
  {(note.page || rotations.length > 0) && (
    <p class="note-annotation sidenote-description">
      {note.page && `Randnotiz S. ${note.page}${rotations.length > 0 ? ',' : ''}`}
      {rotations.map((angle) => {
        const description = angle === 270 ? '90° gegen den Uhrzeigersinn gedreht'
          : angle === 180 ? '180° gedreht' : `${angle}° im Uhrzeigersinn gedreht`;
        return <span class="tr-label" data-rot={angle} data-tooltip={description}
          tabindex="0" aria-label={description} />;
      })}
    </p>
  )}
  <slot />
  {labels.length > 0 && (
    <p class="note-annotation">
      Hand:{' '}
      {labels.map(({ ref, name }, index) => (
        <Fragment>
          {index > 0 && (index === labels.length - 1 ? ' und ' : ', ')}
          <button type="button" data-hand-ref={ref}>
            {name}
          </button>
        </Fragment>
      ))}
    </p>
  )}
</div>
