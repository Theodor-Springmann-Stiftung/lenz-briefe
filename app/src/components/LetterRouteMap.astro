---
import { catalog, gndInformation, type Letter } from '../lib/edition';
import { buildCorrespondenceMap, mapImagePoint, fitLetterMap, alternateLetterMapFit, mergeLetterMapDots, curvedRoute, MAP } from '../lib/correspondence-map.mjs';
import coordinates from '../data/place-coordinates.json';
import mapUrl from '../assets/maps/europe-laea.svg?url';
interface Props { letter: Letter }
const { letter } = Astro.props;
const network = buildCorrespondenceMap({ ...catalog, letters: [letter] }, coordinates.places, gndInformation.places);
const endpoints = ['sent', 'received'].map(type => [...new Set(letter.events.filter(e => e.type === type).flatMap(e => e.locations.map(p => p.ref)))]);
const resolved = endpoints.map(ids => ids.map(id => network.places.find(p => p.id === id)));
const available = resolved.every(side => side.length > 0 && side.every(Boolean));
const sources = available ? resolved[0].map(p => mapImagePoint(p!)) : [];
const targets = available ? resolved[1].map(p => mapImagePoint(p!)) : [];
const points = [...sources, ...targets];
const [from, to] = [sources[0], targets[0]];
const multiple = sources.length > 1 || targets.length > 1;
const fit = available ? fitLetterMap(points) : null;
const same = available && !multiple && from!.id === to!.id;
const showArrow = !multiple && !same;
const alternate = available ? alternateLetterMapFit(points, fit!) : null;
const MapControl = alternate ? 'button' : 'div';
const views = available ? (alternate ? [fit!, alternate] : [fit!]).map((view, index) => {
  const screen = (p: { x: number; y: number }) => ({ x: p.x * view.scale + view.x, y: p.y * view.scale + view.y });
  const a = screen(from!), b = screen(to!);
  const dots = mergeLetterMapDots([...new Map(points.map(p => [p.id, p])).values()].map(p => ({
    ...screen(p), id: p.id,
    source: sources.some(source => source.id === p.id),
    target: targets.some(target => target.id === p.id),
  })));
  return { fit: view, dots, ...curvedRoute(a, b),
    routeSize: same ? 1 : Math.min(1, Math.hypot(b.x - a.x, b.y - a.y) / 24),
    marker: `route-arrow-${letter.letter}-${index}` };
}) : [];
const label = available ? `${sources.map(p => p.name).join(", ")} → ${targets.map(p => p.name).join(", ")}${letter.isDraft ? ' (Entwurf)' : ''}` : 'Briefweg: Ortsangaben fehlen oder sind nicht eindeutig.';
---
{available && (
  <figure class="letter-route-map">
    <MapControl type={alternate ? 'button' : undefined} class="map-zoom" aria-label={alternate ? `${label}: Herauszoomen oder ursprüngliche Ansicht wiederherstellen` : undefined} aria-pressed={alternate ? 'false' : undefined}>
    {views.map(({fit, dots, start, end, control, routeSize, marker}, index) => (
    <svg data-hidden={index === 1 ? "" : undefined} viewBox="0 0 260 200" role="img" aria-label={label}>
      <title>{label}</title>
      <defs>
        <marker id={marker} viewBox="0 0 8 8" refX="7" refY="4" markerUnits="userSpaceOnUse" markerWidth={5 * routeSize} markerHeight={5 * routeSize} orient="auto-start-reverse"><path d="M 0 0 L 8 4 L 0 8 z" fill="#9a4510" /></marker>
      </defs>
      <image href={`${mapUrl}#svg8`} x={fit!.x} y={fit!.y} width={MAP.width * fit!.scale} height={MAP.height * fit!.scale} preserveAspectRatio="none" />
      {showArrow && dots.length > 1 && <path d={`M ${start!.x} ${start!.y} Q ${control!.x} ${control!.y} ${end!.x} ${end!.y}`} fill="none" stroke="#9a4510" stroke-width="1.25" stroke-dasharray={letter.isDraft ? '5 3' : undefined} marker-end={`url(#${marker})`} />}
      {dots.map(dot => dot.merged || (dot.source && dot.target) ? (
        <g transform={`translate(${dot.x} ${dot.y})`}>
          <g data-place-ids={dot.ids.join(' ')}>
            {dot.source && dot.target ? (
              <Fragment>
                <circle r="4" fill="#9a4510" />
                <circle r="2.6" fill="white" />
                <circle r="1.3" fill="#9a4510" />
              </Fragment>
            ) : (
              <circle r="4" fill={dot.source ? 'white' : '#9a4510'}
                stroke={dot.source ? '#9a4510' : undefined} stroke-width={dot.source ? '1.25' : undefined} />
            )}
          </g>
        </g>
      ) : (
        <circle data-place-id={dot.ids[0]} cx={dot.x} cy={dot.y} r="2.5"
          fill={dot.source ? 'white' : '#9a4510'}
          stroke={dot.source ? '#9a4510' : undefined} stroke-width={dot.source ? '1.25' : undefined} />
      ))}
    </svg>
    ))}
    </MapControl>
  </figure>
)}
<script>
  document.querySelectorAll<HTMLButtonElement>('button.map-zoom').forEach(button => {
    button.addEventListener('click', () => {
      const active = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(active));
      button.querySelectorAll('svg').forEach((view, index) => {
        view.toggleAttribute('data-hidden', index !== Number(active));
      });
    });
  });
  document.querySelectorAll('.detail-header-row').forEach(row => {
    const combinedDots = row.querySelectorAll<SVGGElement>('.letter-route-map [data-place-ids]');
    const dots = row.querySelectorAll<SVGCircleElement>('.letter-route-map circle[data-place-id]');
    row.querySelectorAll<HTMLAnchorElement>('.letter-header a[data-reference-kind="place"]').forEach(link => {
      const matchingCombined = [...combinedDots].filter(dot => dot.dataset.placeIds?.split(' ').includes(link.dataset.referenceId!));
      link.addEventListener('mouseenter', () => matchingCombined.forEach(dot => dot.setAttribute('transform', 'scale(1.5)')));
      link.addEventListener('mouseleave', () => matchingCombined.forEach(dot => dot.removeAttribute('transform')));
      const matchingDots = [...dots].filter(dot => dot.dataset.placeId === link.dataset.referenceId);
      link.addEventListener('mouseenter', () => matchingDots.forEach(dot => dot.setAttribute('r', '4.5')));
      link.addEventListener('mouseleave', () => matchingDots.forEach(dot => dot.setAttribute('r', '2.5')));
    });
  });
</script>
<style>
  .letter-route-map { margin:0; align-self:stretch; min-width:0; display:flex; flex-direction:column; background:transparent; border:1px solid #000; overflow:hidden; }
  .map-zoom { display:block; width:100%; padding:0; border:0; background:none; }
  button.map-zoom { cursor:zoom-out; }
  button.map-zoom[aria-pressed="true"] { cursor:zoom-in; }
  .map-zoom:focus-visible { outline:2px solid #9a4510; outline-offset:-3px; }
  svg[data-hidden] { display:none; }
  svg { display:block; width:100%; flex:1; min-height:140px; }
  @media print { .letter-route-map { display:none; } }
</style>
