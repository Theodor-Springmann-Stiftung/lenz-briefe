---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = {
    title?: string;
    description?: string;
    head?: string;
};

const {
    title = "Lenz-Briefe",
    description = "Statische Edition der Briefe von Jakob Michael Reinhold Lenz.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <Font cssVariable="--font-serif" />
        <Font cssVariable="--font-sans" />
        <Font cssVariable="--font-playfair" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title}</title>
        <slot name="head" />
    </head>
    <body>
        <div class="mx-auto flex min-h-screen w-full max-w-[1600px] flex-col px-4">
            <Header />
            <main
                class="grow shrink-0"
                data-pagefind-body
                data-pagefind-filter="bereich:text"
            >
                <slot />
            </main>
            <slot name="meta" />
            <Footer />
        </div>
    </body>
</html>
