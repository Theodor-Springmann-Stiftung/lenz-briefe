---
import '../styles/global.css';
import '../styles/print.css';
import { Font } from 'astro:assets';
import { handSettingsVariables } from '../lib/hand-settings.mjs';
import Icon from '../components/Icon.astro';
import OfflineToggle from '../components/OfflineToggle.astro';
import { base } from '../lib/edition';
import Navigation from '../components/Navigation.astro';
import BackToTop from '../components/BackToTop.astro';
import PrintEditionLink from '../components/PrintEditionLink.astro';
import { revision } from '../lib/revision';
import { pageUrl } from '../lib/pages';
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const {
  title = 'Kritische Briefausgabe von Jakob Michael Reinhold Lenz',
  description = 'Die Briefe von und an Jacob Michael Reinhold Lenz. Digitale Edition.',
  wide = false,
} = Astro.props;
const generatedAt = new Date();
const generationMonth = new Intl.DateTimeFormat('de-DE', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
}).format(generatedAt);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--font-source-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-source-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-source-code" />
    <style is:inline set:html={`:root { ${handSettingsVariables()} }`} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcfcfb" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} sizes="180x180" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a
          class="wordmark"
          href={base}
          aria-label="J. M. R. Lenz – Kritische Briefausgabe – Übersicht"
        >
          <span class="wordmark-logo" aria-hidden="true"></span>
          <span class="wordmark-text">
            <span class="wordmark-name"><span class="wordmark-initials">J.&#8239;M.&#8239;R.</span> LENZ</span>
            <span class="wordmark-caption">Kritische Briefausgabe</span>
          </span>
        </a>
        <Navigation />
      </div>
    </header>
    <main id="inhalt" class:list={['site-shell', { 'site-shell--wide': wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="footer-license-line">
          {[false, true].map((printOnly) => {
            const Tag = printOnly ? 'span' : 'a';
            return (
              <Tag
                class:list={['footer-license', printOnly ? 'print-only' : 'screen-only']}
                href={printOnly ? undefined : 'https://creativecommons.org/licenses/by/4.0/'}
              >
                <span class="footer-license-icons" aria-hidden="true">
                  <Icon name="creativeCommons" />
                  <Icon name="creativeCommonsBy" />
                </span>
                <span class="font-sans">CC BY 4.0</span>
              </Tag>
            );
          })}
          <span aria-hidden="true">·</span>
          <time datetime={generatedAt.toISOString()}>{generationMonth}</time>
        </p>
        <p class="text-right">
          lenz-briefe.de – ein Projekt der{' '}
          <a class="screen-only" href="https://theodor-springmann-stiftung.de/">Theodor Springmann Stiftung</a>
          <span class="print-only">Theodor Springmann Stiftung</span>
          <span class="footer-legal">
            {' '}· <a href={pageUrl('datenschutz')}>Impressum &amp; Datenschutz</a>{' '}
          </span>
          <span class="footer-tools">
            <span aria-hidden="true">·</span>
            <OfflineToggle />
            <span class="footer-offline-separator" aria-hidden="true">·</span>
            <span class="footer-code">
              <Icon name="code" class="footer-code-icon" />
              <a
                class="font-mono"
                href={revision.url}
                aria-label={`Commit ${revision.shortHash.toUpperCase()}`}
              >
                {revision.shortHash.toUpperCase()}
              </a>
            </span>
          </span>
          <span class="print-only footer-archive">
            Mehr über das Jakob Lenz Archiv auf{' '}
            <a href="https://lenz-archiv.de">https://lenz-archiv.de</a>
          </span>
        </p>
      </div>
    </footer>
    <BackToTop />
    <PrintEditionLink />
    <script>
      import '../scripts/tooltips';
    </script>
    <script>
      import '../scripts/site-header';
    </script>
  </body>
</html>
